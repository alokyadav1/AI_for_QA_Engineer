                  "});",
                  "",
                  "pm.test(\"Response contains product data\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    // Handle both array response (GET all) and object response (POST create)",
                  "    if (Array.isArray(jsonData)) {",
                  "        pm.expect(jsonData.length).to.be.greaterThan(0);",
                  "    } else {",
                  "        pm.expect(jsonData).to.be.an(\"object\");",
                  "        pm.expect(jsonData).to.have.property(\"id\");",
                  "    }",
                  "});",
                  "",
                  "pm.test(\"Product structure is valid\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    const product = Array.isArray(jsonData) ? jsonData[0] : jsonData;",
                  "    if (product) {",
                  "        pm.expect(product).to.have.property(\"id\");",
                  "        pm.expect(product).to.have.property(\"title\");",
                  "    }",
                  "});"
                ]
              }
