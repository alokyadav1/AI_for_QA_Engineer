          "name": "Get all products",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Tests for Get All Products (GET)",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response time is under 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test(\"Content-Type header is present\", function () {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "});",
                  "",
                  "pm.test(\"Content-Type is application/json\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "pm.test(\"Response body is valid JSON\", function () {",
                  "    pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test(\"Response is an array of products\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"Products array is not empty\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.be.greaterThan(0);",
                  "});",
                  "",
                  "pm.test(\"Each product has required fields\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    jsonData.forEach(function (product) {",
                  "        pm.expect(product).to.have.property(\"id\");",
                  "        pm.expect(product).to.have.property(\"title\");",
                  "        pm.expect(product).to.have.property(\"price\");",
                  "    });",
                  "});",
                  "",
                  "pm.test(\"Product fields have correct data types\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.length > 0) {",
                  "        const product = jsonData[0];",
                  "        pm.expect(product.id).to.be.a(\"number\");",
                  "        pm.expect(product.title).to.be.a(\"string\");",
                  "        pm.expect(product.price).to.be.a(\"number\");",
                  "    }",
                  "});"
